[sub_resource type="GDScript" id="GDScript_74x36"]
script/source = "extends Area2D
@onready var aviso_chat: Control = $Control
var is_chatting: bool = false
@export var dialogo_recurso: DialogueResource = preload(\"res://dialogue/parque.dialogue\")
@export var dialogo_titulo: String = \"start\"
#var balao = BALAO_CENA.instantiate()

func _on_body_entered(body):
	if body.has_method(\"jogador\"):
		body.pode_interagir = true
		body.npc_proximo = self
		print(\"Contato\")
		
		if aviso_chat:
			aviso_chat.visible = true
		
func _on_body_exited(body):
	if body.has_method(\"jogador\"):
		body.pode_interagir = false
		body.npc_proximo = null
		if aviso_chat:
			aviso_chat.visible = false
const BALAO_CENA = preload(\"res://personalizado.tscn\")

func iniciar_dialogo() -> void:
	# 1. Instancia o balão de diálogo personalizado
	var balao = BALAO_CENA.instantiate()
	print(\"Conversa\")
	# 2. Adiciona o balão na cena atual para que ele apareça visualmente na tela
	get_tree().current_scene.add_child(balao)
	
	# 3. Inicia o diálogo passando o recurso, o título e [self] como contexto para funções locais
	balao.start(dialogo_recurso, dialogo_titulo, [self])
"

